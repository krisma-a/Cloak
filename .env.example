# Copy to .env.local and fill in your Firebase web app's config (Firebase console > Project settings).
# .env.local is git-ignored. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# App Check (reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_SITE_KEY=
# Optional: a fixed App Check debug token for localhost (register it under App Check > Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
# Optional: built-in default cloud model (Remote Config "cloud_model" overrides it)
VITE_CLOUD_MODEL=
# Optional: agent-platform = the Agent Platform (Vertex) Gemini API, paid by Google Cloud credits. Needs Blaze + billing linked.
# Leave empty for the Gemini Developer API (free tier, shared, 429s when busy).
VITE_AI_BACKEND=
