rules_version = '2';

// Cloak Firestore rules.
// Each signed-in user (anonymous counts) can only read and write their own data under
// /users/{uid}/... (redacted drafts and counts-only audit log). Everything else is denied.
// Raw case text and real names are never stored in Firestore.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
